#!/bin/bash
#
# Cache-busting for the floor devices, in two halves.
#
#   1. ?v=N on CLASSIC <script> / <link> tags in src/pages/*.html — bumped here
#      when a file the tag names changes. Only works for files named directly
#      in the HTML, and only when a ?v= is already present.
#   2. ?h=<content-hash> on the ES module graph — both the entry tags and every
#      module they import — regenerated by tools/stamp-modules.mjs.
#
# Both halves are needed. Step 1 alone is what took the dashboard down on
# 2026-08-12: a freshly fetched entry paired with a cached sibling, the named
# import failed, and the whole module graph went with it. See the header of
# stamp-modules.mjs for the full story.
#
# Module entries are on ?h= now, so step 1 no longer matches them — that is
# intended, not a regression. Do not re-add ?v= to a type="module" tag.
#
# INSTALL (hooks live outside version control):
#   cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

CHANGED_FILES=$(git diff --cached --name-only --diff-filter=AMR | grep -E '\.(js|css)$' || true)
[ -z "$CHANGED_FILES" ] && exit 0

PAGE_HTMLS=$(git ls-files 'src/pages/*.html')
[ -z "$PAGE_HTMLS" ] && exit 0

BUMPED=""

bump_version() {
  local pattern="$1"
  local html="$2"

  # Extract current version number
  local current
  current=$(grep -oP "${pattern}\?v=\K\d+" "$html" 2>/dev/null | head -1)
  [ -z "$current" ] && return 1

  local next=$((current + 1))
  sed -i "s|${pattern}?v=${current}|${pattern}?v=${next}|g" "$html"
  git add "$html"
  BUMPED="$BUMPED $html(v${current}->v${next})"
  return 0
}

for FILE in $CHANGED_FILES; do
  BASENAME=$(basename "$FILE")
  PARENT=$(basename "$(dirname "$FILE")")
  MATCH="${PARENT}/${BASENAME}"

  for HTML in $PAGE_HTMLS; do
    # Try parent/filename match first (avoids index.js collisions)
    if grep -Fq "${MATCH}?v=" "$HTML" 2>/dev/null; then
      bump_version "$MATCH" "$HTML"
    # Fallback: bare filename (skip generic names)
    elif [ "$BASENAME" != "index.js" ] && [ "$BASENAME" != "main.js" ]; then
      if grep -Fq "${BASENAME}?v=" "$HTML" 2>/dev/null; then
        bump_version "$BASENAME" "$HTML"
      fi
    fi
  done
done

[ -n "$BUMPED" ] && echo "[auto-version]$BUMPED"

# Re-hash the module graphs. This must run even when no ?v= tag matched — most
# modules (widgets.js, utils.js, ...) are imported, never named in any HTML, so
# the loop above never sees them.
if command -v node >/dev/null 2>&1; then
  STAMP_OUT=$(node tools/stamp-modules.mjs 2>&1)
  STAMP_STATUS=$?
  if [ $STAMP_STATUS -ne 0 ]; then
    echo "[stamp-modules] FAILED — commit aborted"
    echo "$STAMP_OUT"
    exit 1
  fi
  RESTAMPED=$(git diff --name-only -- 'src/pages/*.html')
  if [ -n "$RESTAMPED" ]; then
    git add $RESTAMPED
    echo "[stamp-modules] re-hashed:$(echo $RESTAMPED | tr '\n' ' ')"
  fi
else
  echo "[stamp-modules] node not found — import maps NOT regenerated." >&2
  echo "                Run 'npm run stamp' before pushing, or the deploy" >&2
  echo "                can serve a new entry against cached modules." >&2
fi

exit 0
