#!/bin/bash
#
# Re-hash every asset URL in src/pages/*.html before the commit lands.
#
# Local .js and .css are addressed by content hash — <script src>, <link href>,
# module entries, and the specifiers inside the import map alike:
#
#     ../js/modules/widgets.js?h=9a25eaed
#
# tools/stamp-modules.mjs derives those from the files themselves, so a commit
# that changes a file and forgets to re-stamp ships an HTML page pointing at a
# hash that no longer exists in the tree. This hook makes that impossible
# locally; `npm run stamp:check` in CI catches it for anyone without the hook.
#
# This replaces the old hand-bumped ?v=N scheme entirely. That scheme could only
# see files named directly in the HTML, so it never covered an imported module —
# which is what took the dashboard down on 2026-08-12 (a freshly fetched entry
# paired with a cached sibling, the named import failed, and the whole module
# graph went with it). It also drifted: the same timer.js was requested as ?v=12
# by one page and ?v=10 by another, two cache entries for one file. Do not
# re-introduce ?v= on a .js or .css URL; the stamper owns those now.
#
# INSTALL (hooks live outside version control):
#   cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

# Nothing to do unless an asset or a page actually changed.
CHANGED=$(git diff --cached --name-only --diff-filter=AMR \
  | grep -E '\.(js|mjs|css|html)$' || true)
[ -z "$CHANGED" ] && exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "[stamp-modules] node not found — asset hashes NOT regenerated." >&2
  echo "                Run 'npm run stamp' before pushing, or the deploy can" >&2
  echo "                serve pages pointing at hashes that no longer exist." >&2
  exit 0
fi

STAMP_OUT=$(node tools/stamp-modules.mjs 2>&1)
if [ $? -ne 0 ]; then
  echo "[stamp-modules] FAILED — commit aborted"
  echo "$STAMP_OUT"
  exit 1
fi

RESTAMPED=$(git diff --name-only -- 'src/pages/*.html')
if [ -n "$RESTAMPED" ]; then
  git add $RESTAMPED
  echo "[stamp-modules] re-hashed:$(echo $RESTAMPED | tr '\n' ' ')"
fi

exit 0
