{
  "name": "rogue-origin-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Operations hub for Rogue Origin — production tracking, inventory, SOPs and supply management for a seed-to-sale hemp flower business in Southern Oregon.",
  "keywords": [
    "operations",
    "manufacturing",
    "production-tracking",
    "cloudflare-workers",
    "hemp"
  ],
  "homepage": "https://rogueff.github.io/rogue-origin-apps",
  "bugs": {
    "url": "https://github.com/RogueFF/rogue-origin-apps/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RogueFF/rogue-origin-apps.git"
  },
  "license": "UNLICENSED",
  "author": "Rogue Family Farms",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:tutorial": "playwright test kanban-tutorial.spec.js",
    "test:tutorial:ui": "playwright test kanban-tutorial.spec.js --ui",
    "test:tutorial:debug": "playwright test kanban-tutorial.spec.js --debug",
    "test:dashboard": "playwright test dashboard-widgets.spec.js",
    "test:dashboard:ui": "playwright test dashboard-widgets.spec.js --ui",
    "test:dashboard:debug": "playwright test dashboard-widgets.spec.js --debug",
    "test:headed": "playwright test kanban-tutorial.spec.js --headed",
    "test:chromium": "playwright test kanban-tutorial.spec.js --project=chromium",
    "test:firefox": "playwright test kanban-tutorial.spec.js --project=firefox",
    "test:webkit": "playwright test kanban-tutorial.spec.js --project=webkit",
    "test:mobile": "playwright test kanban-tutorial.spec.js --project=mobile-chrome --project=mobile-safari",
    "playwright:install": "playwright install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:dashboard": "eslint src/js/modules/",
    "lint:scoreboard": "eslint src/js/scoreboard-v2/",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "stamp": "node tools/stamp-modules.mjs --staged",
    "stamp:check": "node tools/stamp-modules.mjs --staged --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.2",
    "wrangler": "^4.81.1"
  }
}
